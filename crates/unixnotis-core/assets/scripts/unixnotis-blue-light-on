#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=crates/unixnotis-core/assets/scripts/unixnotis-blue-light-lib
. "$script_dir/unixnotis-blue-light-lib"

# Keep a healthy active backend, then fall through installed tools that fail to start
start_available_backend
